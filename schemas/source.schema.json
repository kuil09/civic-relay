{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civic-relay.dev/schemas/source.schema.json",
  "title": "Civic Relay Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "publisher",
    "source_type",
    "official",
    "locator",
    "checked_at",
    "confidence"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "law",
        "assembly",
        "government",
        "local_government",
        "public_institution",
        "statistics",
        "research",
        "media",
        "stakeholder",
        "community",
        "other"
      ]
    },
    "official": {
      "type": "boolean"
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "snapshot_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
