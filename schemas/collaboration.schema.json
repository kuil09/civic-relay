{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civic-relay.dev/schemas/collaboration.schema.json",
  "title": "Civic Relay Collaboration Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "created_at",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_copy": {
      "const": true
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "role": {
      "enum": [
        "case_author",
        "evidence_reviewer",
        "policy_editor",
        "recipient_verifier",
        "dispatch_approver",
        "public_release_manager"
      ]
    },
    "participant_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "display_name",
        "participant_kind",
        "roles",
        "visibility"
      ],
      "properties": {
        "participant_id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "participant_kind": {
          "enum": [
            "human",
            "ai",
            "organization"
          ]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        }
      }
    },
    "ordinary_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        }
      }
    },
    "human_decision_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "identity_id",
        "confirmed_human"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "identity_id": {
          "$ref": "#/$defs/id"
        },
        "confirmed_human": {
          "const": true
        }
      }
    },
    "withdrawal_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "consent_entry_id",
        "confirmed_human"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "consent_entry_id": {
          "$ref": "#/$defs/id"
        },
        "confirmed_human": {
          "const": true
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "event_type",
        "actor_id",
        "occurred_at",
        "target",
        "document_hash",
        "payload",
        "previous_entry_hash",
        "entry_hash"
      ],
      "properties": {
        "entry_id": {
          "$ref": "#/$defs/id"
        },
        "event_type": {
          "enum": [
            "participant_registered",
            "contribution",
            "review",
            "dissent",
            "approval",
            "co_sign_consent",
            "consent_withdrawal"
          ]
        },
        "actor_id": {
          "$ref": "#/$defs/id"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "document_hash": {
          "$ref": "#/$defs/hash"
        },
        "previous_entry_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry_hash": {
          "$ref": "#/$defs/hash"
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "participant_registered"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/participant_payload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "enum": [
                  "contribution",
                  "review",
                  "dissent"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/ordinary_payload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "enum": [
                  "approval",
                  "co_sign_consent"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/human_decision_payload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "consent_withdrawal"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/withdrawal_payload"
              }
            }
          }
        }
      ]
    }
  }
}
