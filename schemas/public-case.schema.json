{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civic-relay.dev/schemas/public-case.schema.json",
  "title": "Civic Relay Public Case Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication_id",
    "case_id",
    "title",
    "jurisdiction",
    "dispatchable",
    "published_snapshot_at",
    "source_snapshot_hash",
    "redaction_manifest_hash",
    "assets",
    "restrictions"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "publication_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "jurisdiction": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "dispatchable": { "const": false },
    "published_snapshot_at": { "type": "string", "format": "date-time" },
    "source_snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "redaction_manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "restrictions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
