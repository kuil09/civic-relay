{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civic-relay.dev/schemas/claim.schema.json",
  "title": "Civic Relay Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "text",
    "type",
    "source_ids",
    "confidence",
    "use_in_proposal"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "observation",
        "fact",
        "inference",
        "value_judgment",
        "proposal"
      ]
    },
    "origin": {
      "enum": [
        "user_observation",
        "external_source",
        "agent_analysis",
        "user_value",
        "user_proposal"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contradicting_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unverified"
      ]
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "use_in_proposal": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  }
}
