{
  "name": "civic-relay",
  "version": "0.1.0",
  "description": "A file-first AI agent harness that turns civic problems into reviewable policy packages and accountable delivery paths.",
  "type": "module",
  "private": false,
  "bin": {
    "civic-relay": "./src/cli.js"
  },
  "engines": {
